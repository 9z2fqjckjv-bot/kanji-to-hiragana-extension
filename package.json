{
  "name": "kanji-to-hiragana-extension",
  "version": "1.0.0",
  "description": "Webページの漢字をひらがなに変換するChrome拡張機能（小学生・中学生向け）",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "smoke-test": "node scripts/smoke-test.js",
    "gen-icons": "node scripts/gen-icons.js",
    "prebuild": "npm run gen-icons"
  },
  "dependencies": {
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^12.0.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
